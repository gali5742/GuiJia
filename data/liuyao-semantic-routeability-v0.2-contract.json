{
  "version": "0.2",
  "status": "development_contract",
  "scope": "liuyao_only",
  "task": "routeability",
  "labels": ["route_known", "non_route"],
  "positivePolicy": {
    "route_known": [
      "known_route_sufficient",
      "known_route_insufficient"
    ],
    "note": "Routeability only answers whether the question belongs to the current 22-route semantic inventory. Missing downstream slots or rule availability must not turn a known route into non_route."
  },
  "negativePolicy": {
    "non_route": [
      "outside_current_22",
      "route_unresolved",
      "near_domain_not_current_route"
    ],
    "note": "Policy-disallowed health/disease questions are handled earlier by Divination Policy Gate and are not used as a learned Routeability category."
  },
  "calibration": {
    "objective": "maximize_known_recall_subject_to_false_activation_cap",
    "maxFalseActivation": 0.05,
    "forbiddenObjectives": [
      "balanced_accuracy_only",
      "reuse_scope_gate_threshold",
      "reuse_scope_gate_calibration_policy"
    ]
  },
