  "principles": [
    "Evidence polarity is not Assessment status.",
    "The shared layer must never count evidence items or map arbitrary polarity tokens to supportive/adverse states.",
    "Each evaluator is owned by an eventType+duty+dimension+semanticMeaning Assessment contract family.",
    "Missing evaluator returns not_assessed/evaluator_not_registered; it never falls back to a global heuristic.",
    "Assessment output must retain evidenceRefs and contract provenance.",
    "Unresolved or partial evidence/subject resolution must remain explicit rather than being converted to adverse evidence.",
    "Time Engine facts may be consumed by a domain evidence builder but must not be recomputed inside Assessment.",
    "Static line status and TimeFact transitions are separate provenance layers; a static VOID tag must not be mislabeled as a TimeFact.",
    "Presentation helpers such as classifyTargetState must not be promoted into a formal strength/Assessment engine without independent review.",
    "Reading identity must be carried explicitly rather than inferred from evidence-ref string formatting.",
    "No Assessment output may contain probability, scalarScore, winner or overallRecommendation.",
    "alternativeId is optional for standalone domain assessment and must be explicitly bound before Choice Comparator use; array position or label order must never create the binding."
  ],
  "assessmentEnvelopeSchema": {
    "required": [
      "assessmentRef",
      "assessmentVersion",
      "contractFamily",
      "eventType",
      "duty",
      "dimensionId",
      "semanticMeaning",
      "resolutionStatus",
      "assessmentStatus",
      "evidenceRefs",
      "reasonRefs"
    ],
    "resolutionStatusVocabulary": ["resolved", "partial", "unresolved", "not_applicable"],
    "assessmentStatusVocabulary": [
      "supportive_evidence",
      "adverse_evidence",
      "mixed_evidence",
      "insufficient_evidence",
      "not_assessed"
    ],
    "optional": ["alternativeId", "unresolvedIssues", "traceRefs", "sourceTierRefs"],
    "choiceBindingRule": {
      "alternativeIdRequiredForComparator": true,
      "mustBeExplicit": true,
      "mustNotInferFrom": ["array_index", "left_right_position", "display_label_order"]
    },
    "forbidden": ["probability", "scalarScore", "winner", "overallRecommendation"]
  },
  "readingScopedEnvelopeV02": {
