  "trainingDataPolicy": {
    "allowed": [
      "existing Semantic Router train splits only",
      "fresh sealed Fallback Identity v0.1 training augmentation"
    ],
    "historicalHardNegativeHandling": "train hard negatives with an explicit known-route label are assigned to that route; genuine hard negatives are negative for every head",
    "freshKnownHandling": "positive only for expectedRoute and negative for every other head",
    "freshNonRouteHandling": "negative for every head",
    "deduplicateByNormalizedText": true,
    "conflictingKnownRouteLabels": "fail",
    "forbidden": [
      "all Router validation splits",
      "all sealed blind corpora",
      "Candidate v0.1 independent eval",
