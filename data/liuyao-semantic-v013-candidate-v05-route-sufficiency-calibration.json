      ],
      "missingDimension": "overall_financial_state",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-01-5-S",
      "text": "我最近总入账抵不上花销，往后个人整体财务会有转机吗？",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "general_finances",
      "contrastGroup": "V013-V05-RS-C-01-5",
      "style": "fallback",
      "routeCoverage": [
        "financial_fortune"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-01-5-I",
      "text": "我最近为财务烦心，想占个结果，可还没确定问的是哪笔事。",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "general_finances",
      "contrastGroup": "V013-V05-RS-C-01-5",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "financial_fortune"
      ],
      "missingDimension": "overall_financial_state",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-02-4-S",
      "text": "我问的是花店开张以来持续经营的兴衰，并非某张订单。",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "business",
      "contrastGroup": "V013-V05-RS-C-02-4",
      "style": "support",
      "routeCoverage": [
        "business_operation"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-02-4-I",
      "text": "我想问花店的事情发展如何，还未交代是哪种事情。",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "business",
      "contrastGroup": "V013-V05-RS-C-02-4",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "business_operation"
      ],
      "missingDimension": "ongoing_operation",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-02-5-S",
      "text": "这家洗衣店由我经营，今后维持日常营生会顺畅些吗？",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "business",
      "contrastGroup": "V013-V05-RS-C-02-5",
      "style": "fallback",
      "routeCoverage": [
        "business_operation"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-02-5-I",
      "text": "有件洗衣店相关的事压在心上，它最后会怎样呢？",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "business",
      "contrastGroup": "V013-V05-RS-C-02-5",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "business_operation"
      ],
      "missingDimension": "ongoing_operation",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-03-4-S",
      "text": "这卦只看与茶馆谈妥餐具供货并完成签约的可能。",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-03-4",
      "style": "support",
      "routeCoverage": [
        "commercial_transaction"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-03-4-I",
      "text": "这卦想看茶馆餐具这笔生意，暂未指出要看什么。",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-03-4",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "commercial_transaction"
      ],
      "missingDimension": "deal_completion",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-03-5-S",
      "text": "我报出的窗帘供货方案，对方会答应使这笔生意落地吗？",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-03-5",
      "style": "fallback",
      "routeCoverage": [
        "commercial_transaction"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-03-5-I",
      "text": "窗帘供货这件事让我纠结，究竟会是什么结果？",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-03-5",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "commercial_transaction"
      ],
      "missingDimension": "deal_completion",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-04-4-S",
      "text": "问水果摊的补货安排：由我向产地买入下一车梨作为待售库存。",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-04-4",
      "style": "support",
      "routeCoverage": [
        "inventory_purchase"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-04-4-I",
      "text": "问水果摊和一车梨相关的事情，后面的状况如何？",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-04-4",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "inventory_purchase"
      ],
      "missingDimension": "stock_acquisition",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-04-5-S",
      "text": "我想给渔具柜台补进缺少的鱼线，这次采购库存能如愿吗？",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-04-5",
      "style": "fallback",
      "routeCoverage": [
        "inventory_purchase"
      ],
      "missingDimension": null,
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-04-5-I",
      "text": "渔具柜台的鱼线这件事我想占问，具体是哪个环节还说不清。",
      "label": "route_semantics_insufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-04-5",
      "style": "generic_domain_or_missing_dimension",
      "routeCoverage": [
        "inventory_purchase"
      ],
      "missingDimension": "stock_acquisition",
      "provenance": "fresh_v05_individually_authored_modern_language_contrasts"
    },
    {
      "id": "V013-V05-RS-C-05-4-S",
      "text": "这次关注五金铺现有扳手库存的销售去化，不是增加进货。",
      "label": "route_semantics_sufficient",
      "split": "calibration",
      "domainFamily": "trade_inventory",
      "contrastGroup": "V013-V05-RS-C-05-4",
      "style": "support",
      "routeCoverage": [
        "inventory_sale"
      ],
